# 复制为 halo.env 并修改；该文件含密钥，权限设为 600 且不要提交
#   cp halo.env.example halo.env && chmod 600 halo.env
#
# 数据库密码：随机且够长即可，例如  openssl rand -base64 24 | tr -d '/+=' | head -c 32
HALO_DB_PASSWORD=change-me-before-first-start
#
# 外部访问地址：初始化前必须确定（决定站点链接生成，之后可在管理端改）
#   本机访问：  http://localhost:8090/
#   局域网访问：http://192.168.x.x:8090/
HALO_EXTERNAL_URL=http://localhost:8090/
